    "admin:create": "tsx scripts/create-admin.ts",
    "education:build": "node scripts/build-education-diagrams.mjs",
    "education:deepml": "node scripts/build-deepml.mjs",
    "education:foundations": "node scripts/build-foundations.mjs",
