  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "highlight.js": "^11.11.1",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
