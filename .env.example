# Vercel + Neon: set DATABASE_URL (or POSTGRES_URL) through the Storage integration.
# This is a server-only secret. Never use NEXT_PUBLIC_ for a database URL.
# DATABASE_URL=postgresql://...

# Local development fallback: Node 24+, persistent filesystem required for SQLite.
DATABASE_PATH=./data/mero.sqlite
# Set to the real HTTPS origin before making permanent robot QR labels.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable behind an HTTPS proxy. Keep false for local HTTP development.
COOKIE_SECURE=false
